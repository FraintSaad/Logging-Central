@using Microsoft.AspNetCore.WebUtilities
@{
    ViewData["Title"] = "Logs";

    var dict = Context.Request.Query.ToDictionary(kvp => kvp.Key, kvp => kvp.Value.ToString());
    dict["sortOrder"] = (!Model.CurrentSortOrder).ToString();
    var sortTimeHref = QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["sortBy"] = "Timestamp" });
    var sortLevelHref = QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["sortBy"] = "Level" });
    var sortMessageHref = QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["sortBy"] = "Message" });
    var sortExceptionHref = QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["sortBy"] = "Exception" });
}

<h2>Последние логи</h2>
<form action="/status/logs" method="get">
    <label><input type="checkbox" name="logLevelDebug" @(Model.LogLevelDebug ? "checked" : "") /> Debug</label>
    <label><input type="checkbox" name="logLevelInfo" @(Model.LogLevelInfo ? "checked" : "") /> Information</label>
    <label><input type="checkbox" name="logLevelWarning" @(Model.LogLevelWarning ? "checked" : "") /> Warning</label>
    <label><input type="checkbox" name="logLevelError" @(Model.LogLevelError ? "checked" : "") /> Error</label>
    <input type="submit" value="Применить" />
</form>

<table class="table" height="500">
    <thead>

        <tr>
            <th><a href="@sortTimeHref">Время</a></th>
            <th><a href="@sortLevelHref">Уровень</a></th>
            <th><a href="@sortMessageHref">Сообщение</a></th>
            <th><a href="@sortExceptionHref">Exception</a></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td>@log.Timestamp</td>
                <td>@log.Level</td>
                <td>@log.Message</td>
                <td>@log.Exception</td>
            </tr>
        }
    </tbody>
</table>
<nav>
    <ul class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   href="@QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["page"] = (Model.CurrentPage - 1).ToString() })">
                    Предыдущая
                </a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                   href="@QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["page"] = i.ToString() })">
                    @i
                </a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link"
                   href="@QueryHelpers.AddQueryString(Context.Request.Path, new Dictionary<string, string>(dict) { ["page"] = (Model.CurrentPage + 1).ToString() })">
                    Следующая
                </a>
            </li>
        }
    </ul>
</nav>