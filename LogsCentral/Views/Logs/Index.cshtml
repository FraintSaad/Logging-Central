@model LogsCentral.Models.LogsPageModel
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Logs";
    var tz = TimeZoneInfo.FindSystemTimeZoneById(Model.SelectedTimezoneId ?? "UTC");

    // Helper to safely build URLs reusing current query params but overriding values.
    // Uses ISO ("o") for StartTime/EndTime so the query carries unambiguous UTC values.
    string BuildUrl(object extra)
    {
        var baseParams = Context.Request.Query.ToDictionary(kvp => kvp.Key, kvp => kvp.Value.ToString());

        baseParams.Remove("startTime");
        baseParams.Remove("endTime");

        foreach (var prop in extra.GetType().GetProperties())
        {
            baseParams[prop.Name] = prop.GetValue(extra)?.ToString();
        }

        // Put UTC canonical strings (ISO)
        if (Model.StartTime.HasValue)
            baseParams["startTime"] = Model.StartTime.Value.ToString("o");

        if (Model.EndTime.HasValue)
            baseParams["endTime"] = Model.EndTime.Value.ToString("o");

        return QueryHelpers.AddQueryString(Context.Request.Path, baseParams);
    }

    // Lightweight helper for mapping log levels -> Bootstrap badge classes
    Func<string, string> LevelBadgeClass = lvl =>
    {
        if (string.IsNullOrEmpty(lvl)) return "badge bg-secondary";
        return lvl.ToLowerInvariant() switch
        {
            "debug" => "badge bg-secondary",
            "information" => "badge bg-info text-dark",
            "warning" => "badge bg-warning text-dark",
            "error" => "badge bg-danger",
            _ => "badge bg-light text-dark"
        };
    };
}

<style>
    /* Small visual tweaks */
    table {
        font-size: 0.8rem;
    }

    .filters-card {
        max-width: 100%;
    }

    .level-checkboxes .form-check {
        display: inline-flex;
        align-items: center;
        margin-right: 0.75rem;
    }

    .log-message {
        font-family: monospace;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .table-fixed-time {
        width: 190px;
    }
    /* keeps time column compact */
    .tz-select {
        min-width: 420px;
        max-width: 100%;
    }

    @@media (max-width: 768px) {
        .tz-select {
            width: 100% !important;
            min-width: auto;
        }
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">NS Production Logs</h2>
    <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages</small>
</div>

<div class="card mb-3 filters-card shadow-sm">
    <div class="card-body">
        <form id="logsFilterForm" class="row g-2 align-items-center" action="/logs" method="get">
            <div class="col-12 col-md-auto level-checkboxes">
                <div class="form-check me-1">
                    <input class="form-check-input" type="checkbox" id="levelInfo" name="logLevelInfo" @(Model.LogLevelInfo ? "checked" : "") />
                    <label class="form-check-label ms-1" for="levelInfo">
                        <span class="badge bg-info text-dark">Info</span>
                    </label>
                </div>
                <div class="form-check me-1">
                    <input class="form-check-input" type="checkbox" id="levelWarning" name="logLevelWarning" @(Model.LogLevelWarning ? "checked" : "") />
                    <label class="form-check-label ms-1" for="levelWarning">
                        <span class="badge bg-warning text-dark">Warn</span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="levelError" name="logLevelError" @(Model.LogLevelError ? "checked" : "") />
                    <label class="form-check-label ms-1" for="levelError">
                        <span class="badge bg-danger">Error</span>
                    </label>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-auto">
                    <label class="form-label mb-0 fw-semibold">Timezone</label>
                    <div>
                        <select name="timezoneId" id="timezoneId" class="form-select form-select-sm tz-select">
                            @foreach (var tz in Model.Timezones)
                            {
                                <option value="@tz.Value" selected="@(tz.Selected ? "selected" : null)">
                                    @tz.Text
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-auto">
                    <label class="form-label mb-0 fw-semibold">Start</label>
                    <input type="datetime-local"
                           id="startTime"
                           name="startTime"
                           class="form-control form-control-sm"
                           style="width: 220px;"
                           step="1"
                           value="@(Model.StartLocalForInput?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")" />
                </div>

                <div class="col-12 col-md-auto">
                    <label class="form-label mb-0 fw-semibold">End</label>
                    <input type="datetime-local"
                           id="endTime"
                           name="endTime"
                           class="form-control form-control-sm"
                           style="width: 220px;"
                           step="1"
                           value="@(Model.EndLocalForInput?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")" />
                </div>

                <div class="col-12 col-md-auto d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm me-2">Apply</button>
                </div>
            </div>

        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th class="text-nowrap table-fixed-time">
                    <a class="text-white text-decoration-none" href="@BuildUrl(new { sortBy = "Timestamp", sortOrder = !Model.CurrentSortOrder })">
                        Time
                    </a>
                </th>
                <th class="text-nowrap" style="width: 1%;">
                    <a class="text-white text-decoration-none" href="@BuildUrl(new { sortBy = "Level", sortOrder = !Model.CurrentSortOrder })">
                        Level
                    </a>
                </th>
                <th>
                    <a class="text-white text-decoration-none" href="@BuildUrl(new { sortBy = "Message", sortOrder = !Model.CurrentSortOrder })">
                        Message
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                var localTime = TimeZoneInfo.ConvertTimeFromUtc(log.Timestamp.UtcDateTime, tz);

                <tr>
                    <td class="text-nowrap">
                        @localTime.ToString("yyyy-MM-dd HH:mm:ss")
                    </td>
                    <td class="text-nowrap">
                        @{
                            var lvl = log.Level ?? "";
                            var cls = LevelBadgeClass(lvl);
                        }
                        <span class="@cls">@lvl</span>
                    </td>
                    <td class="log-message">@log.Message</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav aria-label="Logs pagination" class="mt-3">
    <ul class="pagination justify-content-center">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@BuildUrl(new { page = Model.CurrentPage - 1 })" aria-label="Previous">Previous</a>
            </li>
        }

        @{
            int totalPages = Model.TotalPages;
            int current = Model.CurrentPage;
            int window = 2;
        }

        @if (current > 1)
        {
            <li class="page-item @(current == 1 ? "active" : "")">
                <a class="page-link" href="@BuildUrl(new { page = 1 })">1</a>
            </li>
        }

        @if (current - window > 2)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @for (int i = Math.Max(2, current - window); i <= Math.Min(totalPages - 1, current + window); i++)
        {
            <li class="page-item @(i == current ? "active" : "")">
                <a class="page-link" href="@BuildUrl(new { page = i })">@i</a>
            </li>
        }

        @if (current + window < totalPages - 1)
        {
            <li class="page-item disabled"><span class="page-link">…</span></li>
        }

        @if (totalPages > 1)
        {
            <li class="page-item @(current == totalPages ? "active" : "")">
                <a class="page-link" href="@BuildUrl(new { page = totalPages })">@totalPages</a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" href="@BuildUrl(new { page = Model.CurrentPage + 1 })" aria-label="Next">Next</a>
            </li>
        }
    </ul>
</nav>

@section Scripts {
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            const tzSelect = document.getElementById("timezoneId");
            tzSelect.addEventListener("change", function () {
                document.getElementById("logsFilterForm").submit();
            });
        });
    </script>
}