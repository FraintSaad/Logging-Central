@using LogsCentral.ViewModels
@model IEnumerable<AlertRuleViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Alert Rules</h2>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createRuleModal">
            <i class="bi bi-plus-circle me-1"></i> Add Rule
        </button>
    </div>

    <div class="card shadow-sm rounded">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Log Level</th>
                        <th>Lookback Period</th>
                        <th>Threshold</th>
                        <th>Email</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var rule in Model)
                        {
                            <tr>
                                <td>@rule.LogLevel</td>
                                <td>@rule.LookbackPeriod min</td>
                                <td>@rule.Threshold</td>
                                <td>@string.Join(",", rule.Recipients)</td>
                                <td>@rule.CreatedAt.ToString("g")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editRuleModal"
                                            data-id="@rule.Id"
                                            data-loglevel="@rule.LogLevel"
                                            data-period="@rule.LookbackPeriod"
                                            data-threshold="@rule.Threshold"
                                            data-email="@string.Join(",", rule.Recipients)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>

                                    <form action="@Url.Content($"~/alert-rules/delete/{rule.Id}")"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No rules defined yet. Click <b>Add Rule</b> to create one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Rule Modal -->
<div class="modal fade" id="createRuleModal" tabindex="-1" aria-labelledby="createRuleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title">Create Alert Rule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form action="@Url.Content("~/alert-rules/add")" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Log Level</label>
                        <select class="form-select" name="selectedLevel">
                            <option value="Information">Information</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Lookback Period</label>
                        <select class="form-select" name="LookbackPeriod">
                            <option value="1">1 minute</option>
                            <option value="5">5 minutes</option>
                            <option value="15">15 minutes</option>
                            <option value="30">30 minutes</option>
                            <option value="60">1 hour</option>
                            <option value="360">6 hours</option>
                            <option value="720">12 hours</option>
                            <option value="1440">24 hours</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Threshold</label>
                        <input type="number" class="form-control" name="Threshold" min="0" max="1000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Recipients</label>
                        <input type="email" class="form-control" name="Email" placeholder="alerts@example.com, notifications@example.com" />
                    </div>
                    <div class="modal-footer px-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Rule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Rule Modal -->
<div class="modal fade" id="editRuleModal" tabindex="-1" aria-labelledby="editRuleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="editRuleModalLabel">Edit Alert Rule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="edit-form" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="edit-id" />

                    <div class="mb-3">
                        <label class="form-label">Log Level</label>
                        <select class="form-select" name="selectedLevel" id="edit-loglevel">
                            <option value="Information">Information</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Threshold</label>
                        <input type="number" class="form-control" name="Threshold" id="edit-threshold" min="0" max="1000" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Lookback Period</label>
                        <select class="form-select" name="LookbackPeriod" id="edit-period">
                            <option value="5">5 min</option>
                            <option value="10">10 min</option>
                            <option value="15">15 min</option>
                            <option value="30">30 min</option>
                            <option value="60">1 hour</option>
                            <option value="360">6 hours</option>
                            <option value="720">12 hours</option>
                            <option value="1440">24 hours</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control" name="Email" id="edit-email" placeholder="alerts@example.com, johndoe@example.com" />
                    </div>

                    <div class="modal-footer px-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Rule</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var baseEditUrl = '@Url.Content("~/alert-rules/edit/")';

        var editModal = document.getElementById('editRuleModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;

            var id        = btn.getAttribute('data-id');
            var logLevel  = btn.getAttribute('data-loglevel');
            var period    = btn.getAttribute('data-period');
            var threshold = btn.getAttribute('data-threshold');
            var email     = btn.getAttribute('data-email');

            document.getElementById('edit-id').value = id;
            document.getElementById('edit-loglevel').value = logLevel;
            document.getElementById('edit-period').value = period;
            document.getElementById('edit-threshold').value = threshold;
            document.getElementById('edit-email').value = email;

            document.getElementById('edit-form').action = baseEditUrl + id;
        });
    </script>
}
