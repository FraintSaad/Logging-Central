@model StatusPageModel

<h2>Logs stats</h2>

<p>Last day logs: @Model.LastDayCount</p>
<p>Last week logs: @Model.LastWeekCount</p>
<p>Last month logs: @Model.LastMonthCount</p>

<form method="get">
    <label>Choose period (days): <input type="number" name="days" value="@Model.SelectedDays" /></label>
    <button type="submit">Apply</button>
</form>

<h3>Total logs for the selected period: @Model.SelectedPeriodCount</h3>

<canvas id="logsChart" width="400" height="400"></canvas>

