@using LogsCentral.ViewModels
@model List<NotificationRuleViewModel>
@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>
<p>If there were Y logs with Z level in the last X minutes, then send notifications to the specified mailboxes</p>
<form asp-action="Add" method="post">
    <label>Minutes:</label>
    <input type="number" name="Period" required />

    <label>Logs count:</label>
    <input type="number" name="ThrashHold" required />

    <label>Logs level:</label>
    <input type="checkbox" name="selectedLevels" value="Debug" /> Debug
    <input type="checkbox" name="selectedLevels" value="Info" /> Info
    <input type="checkbox" name="selectedLevels" value="Warning" /> Warning
    <input type="checkbox" name="selectedLevels" value="Error" /> Error

    <label>Mail:</label>
    <input type="email" name="Email" multiple required />

    <button type="submit">Add</button>
</form>

<hr />

<table class="table">
    <thead>
        <tr>
            <th>Minutes</th>
            <th>Threshold</th>
            <th>Levels</th>
            <th>Email</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>@n.Period</td>
                <td>@n.Threshold</td>
                <td>@n.LogLevels</td>
                <td>@n.Email</td>
                <td>@n.CreatedAt</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@n.Id" method="post" style="display:inline;">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
